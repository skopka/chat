<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Skopka.Chat.ServerTrusted.Blazor</PackageId>
    <Description>Server-trusted (no end-to-end encryption) Blazor Server components for Skopka.Chat: prerender-safe conversation, live updates through content-free signals and an unread badge.</Description>
    <PackageTags>chat;server-trusted;blazor;blazor-server;skopka</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <ProjectReference Include="..\Skopka.Chat.ServerTrusted\Skopka.Chat.ServerTrusted.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Skopka.Chat.ServerTrusted.Blazor.Tests" />
  </ItemGroup>

</Project>
