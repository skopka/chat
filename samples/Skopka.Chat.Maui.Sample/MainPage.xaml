<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Skopka.Chat.Maui.Sample.MainPage"
    x:DataType="local:MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Skopka.Chat.Maui.Sample"
    xmlns:chat="clr-namespace:Skopka.Chat.UI.Maui;assembly=Skopka.Chat.UI.Maui"
    Title="Skopka.Chat">
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="All">
        <Label x:Name="StatusLabel" Grid.Row="0" Padding="12,8" Text="Configure trusted authentication to start." />
        <chat:SkopkaChatView x:Name="ChatView" Grid.Row="1" />
    </Grid>
</ContentPage>
