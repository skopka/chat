@* Host wrapper: islands accept only simple values, so delegates and options are set here. "Ask in chat" buttons
   outside the island reach AskAboutAsync through chat-ask.js; the draft reference changes without recreating the chat. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
<ServerTrustedChat @ref="_chat"
                   ConversationId="ConversationId"
                   UserId="UserId"
                   Strings="ServerTrustedChatStrings.Russian"
                   CssClass="sample-chat"
                   CatchUpInterval="TimeSpan.FromSeconds(10)"
                   AllowAttachments="true"
                   AttachmentAccept="image/png,image/jpeg,image/webp"
                   AttachmentUrl="@(attachment => $"/chat/attachments/{attachment.Id}")"
                   DraftReferenceType="@(string.IsNullOrEmpty(LessonId) ? null : "lesson")"
                   DraftReferenceId="@LessonId"
                   ReferenceLabel="@(reference => reference.Type == "lesson" ? $"Урок {reference.Id}" : $"Задача {reference.Id}")"
                   ParticipantName="@(participant => participant.Label switch { "parent" => "родитель", "teacher" => "преподаватель", "learner" => "ученик", _ => participant.Label })"
                   ReportReasons="Reasons"
                   ReportReasonLabel="@(code => code == "abuse" ? "Оскорбление" : "Спам")"
                   TimeFormatter="@(time => time.ToOffset(TimeSpan.FromHours(3)).ToString("dd.MM HH:mm", System.Globalization.CultureInfo.InvariantCulture))" />

@code {
    private static readonly IReadOnlyList<string> Reasons = ["abuse", "spam"];

    [Parameter, EditorRequired]
    public Guid ConversationId { get; set; }

    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    [Parameter]
    public string? LessonId { get; set; }

    private ServerTrustedChat? _chat;

    private DotNetObjectReference<MentorChat>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sampleChatAsk.register", _self);
        }
    }

    /// <summary>Places the task in the draft; the engine authorizes the reference again on send.</summary>
    [JSInvokable]
    public async Task AskAboutAsync(string type, string id)
    {
        if (_chat is not null && type == "task" && ServerTrustedChatValidation.IsReferenceId(id))
        {
            await _chat.SetDraftReferenceAsync(new HostReference(type, id));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("sampleChatAsk.unregister", _self);
            }
            catch (JSDisconnectedException)
            {
            }

            _self.Dispose();
        }
    }
}
