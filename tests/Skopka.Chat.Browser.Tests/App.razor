@namespace Skopka.Chat.Browser.Testing
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@implements IAsyncDisposable
<p id="status">@_status</p>
@code {
    private string _status = "Starting";
    private BrowserTests? _tests;
    private DotNetObjectReference<BrowserTests>? _reference;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _tests = new BrowserTests(JS, new Uri(Navigation.BaseUri));
        _reference = DotNetObjectReference.Create(_tests);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./tests.mjs");
        await _module.InvokeVoidAsync("install", _reference);
        _status = "ready";
        StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        _reference?.Dispose();
        if (_module is not null) await _module.DisposeAsync();
    }
}
